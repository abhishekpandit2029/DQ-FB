{
  "name": "dailyquill",
  "version": "1.0.0",
  "private": true,
  "description": "DailyQuill — a private daily diary with follow requests, realtime chat and calling",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "start": "concurrently -n api,web -c cyan,magenta \"npm:start:backend\" \"npm:start:frontend\"",
    "start:backend": "npm run start --workspace backend",
    "start:frontend": "npm run start --workspace frontend",
    "typecheck": "npm run typecheck --workspace backend && npm run typecheck --workspace frontend",
    "lint": "npm run lint --workspace frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=18.18"
  }
}
