# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# Browser origins allowed to call this API (comma separated).
CORS_ORIGINS=http://localhost:3000

# Leave blank in development. In production set to your shared parent domain
# (e.g. .dailyquill.com) so the auth cookie works across api/www subdomains.
COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Transactions are used for follow accepts and comment counters, so this must
# be a replica set — MongoDB Atlas works out of the box.
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/dailyquill

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
TOKEN_SECRET=replace-with-a-long-random-string
TOKEN_EXPIRY=7d

# ---------------------------------------------------------------------------
# Email (OTP delivery)
# ---------------------------------------------------------------------------
# Gmail requires an App Password, not your account password.
# If left blank, OTP codes are printed to the server log instead of emailed.
EMAIL_USER=
EMAIL_PASS=

# ---------------------------------------------------------------------------
# Cloudinary (profile photos)
# ---------------------------------------------------------------------------
CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# AI draft assistant (optional)
# ---------------------------------------------------------------------------
AIML_API_KEY=
